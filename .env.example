# ---------------------------------------------------------------------------
# Delphi / chain
# ---------------------------------------------------------------------------
DELPHI_NETWORK=testnet
# Testnet key: https://delphi-api-access.gensyn.ai/
# Mainnet key: https://api-access.delphi.fyi/
DELPHI_API_ACCESS_KEY=
DELPHI_SIGNER_TYPE=private_key
WALLET_PRIVATE_KEY=

# Optional overrides — the SDK has correct defaults per network.
# GENSYN_RPC_URL=
# DELPHI_API_BASE_URL=

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------
# NEVER put a real key here — this file is committed. Put it in .env instead.
OPENROUTER_API_KEY=
# Free tier by default. Each slot is a `|` fallback chain (free tiers rate-limit).
# Verified working: nemotron-3-ultra-550b, gpt-oss-20b, laguna-s-2.1,
# gemma-4-26b-a4b, openrouter/free. Avoid nemotron-3-super-120b (truncates).
TRIAGE_MODEL=poolside/laguna-s-2.1:free|openai/gpt-oss-20b:free|openrouter/free
ENSEMBLE_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free|openrouter/free,openai/gpt-oss-20b:free|google/gemma-4-26b-a4b-it:free,poolside/laguna-s-2.1:free|openrouter/free
# Set true to permit paid models (better judge replication, real cost).
ALLOW_PAID_FALLBACK=false
# Force the judge-replication model, overriding the market's own judge.
JUDGE_MODEL=
# Also query the model named in each market's metadata.model.model_identifier —
# it is the judge that actually settles the market.
REPLICATE_JUDGE=true
# Free models are slower than paid (a 550B free model measures ~72s).
LLM_TIMEOUT_MS=90000
LLM_MAX_RETRIES=3
# Hard ceiling on LLM spend per run. Free models make this ~0 anyway.
LLM_MAX_COST_PER_RUN_USD=0.5

# ---------------------------------------------------------------------------
# Decision thresholds
#
# MINIMUM_EDGE gates realEdge (probability - breakeven probability), NOT the
# naive "our probability - market probability". It is a stricter quantity, so
# the README's original 0.12 is not the right scale. Stage 8 re-tunes these
# from measured calibration; treat them as placeholders.
# ---------------------------------------------------------------------------
CONFIDENCE_THRESHOLD=0.75
MINIMUM_EDGE=0.08
MINIMUM_EV_PER_TOKEN=0.05

# ---------------------------------------------------------------------------
# Sizing
# ---------------------------------------------------------------------------
MAX_POSITION_SIZE=0.05
KELLY_FRACTION=0.35
# Refuse to become more than this fraction of a market's redeemable supply.
# Guards against near-empty markets where the payout model degenerates.
MAX_SHARE_OF_MARKET=0.25

# ---------------------------------------------------------------------------
# Risk
# ---------------------------------------------------------------------------
MAX_EXPOSURE_PER_MARKET=0.1
MAX_EXPOSURE_PER_CORRELATED_GROUP=0.2
MAX_TOTAL_EXPOSURE=0.7
MAX_DAILY_TRADES=30
MAX_TRADES_PER_RUN=5
MAX_DRAWDOWN=0.25
REQUIRE_VERIFIABLE=false
MIN_HOURS_TO_SETTLEMENT=2
# Competition close. Markets settling after this are skipped — DPM capital is
# locked until settlement, so they cannot contribute to final P&L.
# TRADING_WINDOW_END=2026-09-01T00:00:00Z

# ---------------------------------------------------------------------------
# Execution
# ---------------------------------------------------------------------------
SLIPPAGE_TOLERANCE=0.02
MAX_REQUOTE_DRIFT=0.03

# ---------------------------------------------------------------------------
# Payout model — MUST be calibrated in Stage 3 (npm run validate:payout).
# At settlement the pool is reduced by marketCreatorReward, refund and
# marketCreatorTradingFeesCut before holders redeem. This haircut is a
# deliberately pessimistic placeholder until measured against real redemptions.
# ---------------------------------------------------------------------------
PAYOUT_CREATOR_HAIRCUT=0
ASSUMED_FAILURE_PROBABILITY=0.02

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
# Value a real wallet's portfolio without holding its key (read-only).
# WATCH_WALLET=
# Bankroll assumed in a dry run with no wallet, so sizing stays realistic.
PAPER_BANKROLL_USDC=1000

MARKET_LIMIT=50
DATABASE_PATH=database/state.db
LOG_LEVEL=info
# LOG_FORMAT=json
KILL_SWITCH=false

{
  "name": "delphi-agent-arena-bot",
  "version": "1.0.0",
  "description": "AI-powered DPM prediction-market trading agent for the Gensyn Delphi Agent Arena",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/app.ts --fake --dry-run",
    "start": "tsx src/app.ts",
    "smoke:ai": "tsx scripts/smoke-openrouter.ts",
    "dev:ai": "tsx src/app.ts --fake --dry-run --live-ai",
    "probe": "tsx scripts/probe.ts",
    "validate:payout": "tsx scripts/validate-payout.ts",
    "wallet": "tsx scripts/wallet.ts",
    "faucet": "tsx scripts/faucet.ts",
    "bridge": "tsx scripts/bridge-eth.ts",
    "live:dry": "tsx src/app.ts --dry-run --live-ai",
    "live:one": "tsx src/app.ts --live-ai --max-trades 1",
    "live": "tsx src/app.ts --live-ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Felabs1/Delphi_Agent_Arena_Bot.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Felabs1/Delphi_Agent_Arena_Bot/issues"
  },
  "homepage": "https://github.com/Felabs1/Delphi_Agent_Arena_Bot#readme",
  "dependencies": {
    "@gensyn-ai/gensyn-delphi-sdk": "^2.0.0",
    "better-sqlite3": "^13.0.2",
    "dotenv": "^17.4.2",
    "viem": "^2.55.10",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
